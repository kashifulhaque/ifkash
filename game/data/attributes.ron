// Attributes and derived-stat curves.
// Source: docs/game/03-combat.md, "Attributes" and "Derived stats".
//
// Curve values are fixed-point tenths (for example 508 means 50.8) so evaluation is
// exact integer math. A curve is the stat at attribute `min`, plus `per_point_tenths`
// for each point above it, with the rate changing at each segment's `until` breakpoint.
#![enable(implicit_some)]
(
  min: 1,
  max: 60,
  start_min: 4,
  start_max: 16,
  level_offset: 60, // character level = sum of attributes - level_offset
  // Glimmer to go from level L to L + 1: floor(base + per_level * L + quad_tenths * L^2 / 10).
  // Source: docs/game/06-progression-and-systems.md, "Leveling".
  level_cost: (base: 100, per_level: 20, quad_tenths: 12),
  attributes: [
    (id: "attr_vitality", name: "Vitality"),
    (id: "attr_focus", name: "Focus"),
    (id: "attr_endurance", name: "Endurance"),
    (id: "attr_might", name: "Might"),
    (id: "attr_finesse", name: "Finesse"),
    (id: "attr_insight", name: "Insight"),
    (id: "attr_devotion", name: "Devotion"),
  ],
  max_hp: (
    base_tenths: 3000,
    segments: [(until: 20, per_point_tenths: 300), (until: 40, per_point_tenths: 250), (until: 60, per_point_tenths: 80)],
  ),
  max_fp: (
    base_tenths: 400,
    segments: [(until: 20, per_point_tenths: 50), (until: 40, per_point_tenths: 30), (until: 60, per_point_tenths: 10)],
  ),
  max_stamina: (
    base_tenths: 800,
    segments: [(until: 20, per_point_tenths: 20), (until: 40, per_point_tenths: 10), (until: 60, per_point_tenths: 5)],
  ),
  max_equip_load: (
    base_tenths: 400,
    segments: [(until: 20, per_point_tenths: 12), (until: 40, per_point_tenths: 12), (until: 60, per_point_tenths: 6)],
  ),
  // 2 slots at attribute 10, +1 every 8 points above that.
  spell_slots: (base: 2, from: 10, every: 8),
  // Applies to the attribute that raises each resistance (see the spec's attribute table).
  resistance: (
    base_tenths: 830,
    segments: [(until: 60, per_point_tenths: 30)],
  ),
  // Attack rating and damage (docs/game/03-combat.md, "Attack rating", "Damage dealt").
  damage: (
    max_upgrade: 10, // Attack rating: upgrade level 0-10
    base_per_upgrade_permille: 60, // base(U) = base_damage * (1 + 0.06 * U)
    scaling_per_upgrade_percent: 3, // k_a(U) = scaling_a * (1 + 0.03 * U)
    // curve(x): 0.40 at 20 (0.02 a point), 0.75 at 40 (0.0175 a point), 1.0 at 60 (0.0125).
    scaling_curve: [
      (until: 20, per_point_ppm: 20000),
      (until: 40, per_point_ppm: 17500),
      (until: 60, per_point_ppm: 12500),
    ],
    unwieldy_base_percent: 60, // Requirements: base damage x 0.6
    unwieldy_recovery_percent: 20, // Requirements: recovery frames +20 percent
    two_hand_might_percent: 150, // Two-handing: Might counts as 1.5x
    counter_percent: 115, // Damage dealt, counter_mult: 1.15
    buff_cap_percent: 150, // Damage dealt, buff_mult: capped at 1.5
    absorption_cap_percent: 70, // Damage dealt, absorption_type: capped at 0.7
  ),
)
