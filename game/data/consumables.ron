// Consumables, flasks, and pickups.
// Source: docs/game/04-arsenal-and-builds.md, "Consumables"; docs/game/06-progression-and-systems.md,
// "Flasks" and "Equipment slots"; docs/game/03-combat.md, "Combat verbs" (Drink a flask).
// Schema: crates/content/src/consumables.rs. The flasks, Wick Bead, and Flask Dew are
// special-cased; every other usable item names its `effect` (WP-057).
(
  flask: (
    vigil: "itm_vigil_flask",
    lucid: "itm_lucid_flask",
    drink_move: "flask_drink",
    wick_bead: "itm_wick_bead",
    flask_dew: "itm_flask_dew",
    start_charges: 4, // Flasks: start with 4 charges
    start_vigil: 3, // tuning: the spec doesn't fix the starting split; 3 Vigil, 1 Lucid
    max_charges: 10, // Flasks: Wick Beads raise it up to 10
    max_level: 6, // Flasks: Flask Dew raises potency up to +6
    heal_base: 300, // Consumables, Vigil Flask: heal 300 HP at +0
    heal_per_level: 50, // +50 per upgrade
    fp_base: 60, // Consumables, Lucid Flask: restore 60 FP at +0
    fp_per_level: 10, // +10 per upgrade
    effect_frame: 16, // Combat verbs, Drink a flask: 16 (heal lands)
    walk_percent: 40, // Combat verbs, Drink a flask: walk speed 40%
  ),
  items: [
    (id: "itm_vigil_flask", name: "Vigil Flask", kind: VigilFlask, stack: 0),
    (id: "itm_lucid_flask", name: "Lucid Flask", kind: LucidFlask, stack: 0),
    // WP-057: each usable item's `effect` is below. A thrown item's numbers are attack
    // rating (the spec's damage), so they don't scale with the thrower's weapon.
    (id: "itm_pitch_bomb", name: "Pitch Bomb", kind: Throwable, stack: 10, effect: Throw(projectile: "proj_pitch_bomb_thrown", phys: 0, elem: 120)), // 120 Fire in a 2 m radius
    (id: "itm_frostjar", name: "Frostjar", kind: Throwable, stack: 10, effect: Throw(projectile: "proj_frostjar", phys: 0, elem: 60)), // 60 Aether, Rime 80
    (id: "itm_blight_pot", name: "Blight Pot", kind: Throwable, stack: 5, effect: Throw(projectile: "proj_blight_pot", phys: 0, elem: 0)), // Blight 120
    (id: "itm_throwing_knife", name: "Poison Knife", kind: Throwable, stack: 20, effect: Throw(projectile: "proj_throwing_knife", phys: 40, elem: 0)), // 40 Pierce, Poison 40
    (id: "itm_pitch_oil", name: "Pitch Oil", kind: WeaponBuff, stack: 5, effect: Oil(buff: "buf_pitch_oil")),
    (id: "itm_spark_oil", name: "Spark Oil", kind: WeaponBuff, stack: 5, effect: Oil(buff: "buf_spark_oil")),
    (id: "itm_bloodbloom_oil", name: "Bloodbloom Oil", kind: WeaponBuff, stack: 5, effect: Oil(buff: "buf_bloodbloom_oil")),
    (id: "itm_clotweed", name: "Clotweed", kind: Cure, stack: 10, effect: Cure(kinds: [Rupture])),
    (id: "itm_antidote_root", name: "Antidote Root", kind: Cure, stack: 10, effect: Cure(kinds: [Poison])),
    (id: "itm_clearwater", name: "Clearwater Draught", kind: Cure, stack: 5, effect: Cure(kinds: [Blight])),
    (id: "itm_hearth_ember", name: "Hearth Ember", kind: Cure, stack: 5, effect: Cure(kinds: [Rime])),
    (id: "itm_waking_salts", name: "Waking Salts", kind: Cure, stack: 5, effect: Cure(kinds: [Drowse, Delirium])),
    (id: "itm_glimmer_vial", name: "Glimmer Vial (small)", kind: Glimmer, stack: 99, effect: Glimmer(amount: 200)),
    (id: "itm_glimmer_vial_large", name: "Glimmer Vial (large)", kind: Glimmer, stack: 99, effect: Glimmer(amount: 1000)),
    (id: "itm_lantern_ash", name: "Lantern Ash", kind: LanternAsh, stack: 5, effect: LanternAsh),
    (id: "itm_arrows", name: "Iron Arrows", kind: Ammunition, stack: 99, effect: Ammo(projectile: "proj_arrow", elem_percent: 0)),
    (id: "itm_arrows_fire", name: "Fire Arrows", kind: Ammunition, stack: 99, effect: Ammo(projectile: "proj_arrow_fire", elem_percent: 20)), // tuning: the oils' 20% of AR
    (id: "itm_arrows_storm", name: "Storm Arrows", kind: Ammunition, stack: 99, effect: Ammo(projectile: "proj_arrow_storm", elem_percent: 20)),
    (id: "itm_wick_bead", name: "Wick Bead", kind: WickBead, stack: 0),
    (id: "itm_flask_dew", name: "Flask Dew", kind: FlaskDew, stack: 0),
    (id: "itm_yard_key", name: "Yard Key", kind: Key, stack: 1), // WP-042: opens a keyed door
    (id: "itm_rewrite_quill", name: "Rewrite Quill", kind: Key, stack: 3), // WP-050: one respec each, at a Lantern
    (id: "itm_echo_bell", name: "Echo Bell", kind: EchoBell, stack: 1), // WP-059: summons an Echo at an Echo Stone
    // WP-053: Smith materials, all key items with no effect. The Forgeglass and Starglass are
    // spent at the Smith, the Ember unlocks the high levels, and a whetstone is one temper.
    // WP-054: Art Scrolls, one per Art. Using one changes the held common weapon's Art, if the
    // weapon's class can use it.
    (id: "itm_art_scroll_feint_step", name: "Art Scroll: Feint Step", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_feint_step")),
    (id: "itm_art_scroll_rending_sweep", name: "Art Scroll: Rending Sweep", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_rending_sweep")),
    (id: "itm_art_scroll_bastion", name: "Art Scroll: Bastion", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_bastion")),
    (id: "itm_art_scroll_windward_parry", name: "Art Scroll: Windward Parry", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_windward_parry")),
    (id: "itm_art_scroll_rising_cleave", name: "Art Scroll: Rising Cleave", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_rising_cleave")),
    (id: "itm_art_scroll_rallying_roar", name: "Art Scroll: Rallying Roar", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_rallying_roar")),
    (id: "itm_art_scroll_lunging_thrust", name: "Art Scroll: Lunging Thrust", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_lunging_thrust")),
    (id: "itm_art_scroll_earthsplit", name: "Art Scroll: Earthsplit", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_earthsplit")),
    (id: "itm_art_scroll_rime_edge", name: "Art Scroll: Rime Edge", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_rime_edge")),
    (id: "itm_art_scroll_radiant_blade", name: "Art Scroll: Radiant Blade", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_radiant_blade")),
    (id: "itm_art_scroll_spark_volley", name: "Art Scroll: Spark Volley", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_spark_volley")),
    (id: "itm_art_scroll_lantern_flare", name: "Art Scroll: Lantern Flare", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_lantern_flare")),
    (id: "itm_art_scroll_glass_barrage", name: "Art Scroll: Glass Barrage", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_glass_barrage")),
    (id: "itm_art_scroll_toll", name: "Art Scroll: Toll", kind: ArtScroll, stack: 5, effect: ArtScroll(art: "art_toll")),
    (id: "itm_forgeglass_shard", name: "Forgeglass Shard", kind: Key, stack: 99),
    (id: "itm_forgeglass_chunk", name: "Forgeglass Chunk", kind: Key, stack: 99),
    (id: "itm_starglass", name: "Starglass", kind: Key, stack: 99),
    (id: "itm_temper_whetstone", name: "Temper Whetstone", kind: Key, stack: 5),
    (id: "itm_forgeheart_ember", name: "Forgeheart Ember", kind: Key, stack: 1),
  ],
)
