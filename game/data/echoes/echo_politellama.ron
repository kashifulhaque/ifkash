    ),
    (
      id: "ep_llama_stomp",
      anim: "ep_llama_stomp",
      total_frames: 58,
      stamina: 0,
      fp: 0,
      root_motion: [(0, 0.0), (18, 0.0), (22, 0.4), (58, 0.4)],
      track_deg_per_tick: 4.0,
      hyperarmor: None,
      iframes: None,
      cancel_attack_from: None,
      cancel_dodge_from: None,
      cancel_any_from: None,
      next_chain: None,
      hitboxes: [
        (
          frames: (20, 24),
          shape: Sphere(center: (0.0, 0.3, 0.9), radius: 1.5),
          motion_value: 0.9,
          phys: Blunt,
          element: None,
