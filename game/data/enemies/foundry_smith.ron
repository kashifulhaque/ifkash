// The Foundry Smith (registry 7086): an elite. Source: docs/game/05-enemies-and-bosses.md,
// "Enemy roster" elites (HP 1,500; hammer and tongs; hammer slams leave burning metal on
// the ground). There is no ground hazard system yet, so `fs_hammer` carries a long-lived
// Fire hitbox where the slam landed; it strikes each target once. Weakness and stats are
// tuning.
#![enable(implicit_some)]
(
  id: "foundry_smith",
  model: "smith_foundry",
  hp: 1500,
  poise: 80,
  stance: 100,
  defense: (flat: 70),
  resist: (immunity: 200, robustness: 220, composure: 160),
  glimmer: 700,
  attack: 140,
  speed_percent: 80,
  perception: (sight_deg: 110.0, sight_m: 18.0, hearing_mult: 0.9),
  moveset: "enemies/foundry_smith.ron",
  options: [
    (move: "fs_hammer", when: [DistBelow(3.0), FacingWithin(40.0)], weight: 5, cooldown: 120),
    (move: "fs_sweep", when: [DistBelow(2.8), FacingWithin(50.0)], weight: 4, cooldown: 60),
    (move: "fs_tongs", when: [DistBelow(2.0), FacingWithin(40.0)], weight: 4, cooldown: 40),
    (behavior: Approach(dur: 30), when: [DistAbove(2.6)], weight: 4),
    (behavior: Strafe(dur: 40), when: [DistBetween(2.0, 6.0)], weight: 1, cooldown: 120),
  ],
  drops: [(item: "itm_glimmer_vial_large", chance: 0.5)],
)
