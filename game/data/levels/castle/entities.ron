// The Castle Graymantle entities (WP-064, part 1). Yaw is in radians from +Z toward +X: 0 faces
// +Z (north, toward the castle), 3.1415927 faces -Z, 1.5707964 faces +X, -1.5707964 faces -X.
//
// Part 1 is Bridge and Barbican (L14, L15) and the Lower Ward. The main route: the spawn on the
// cliff plaza -> L14 -> the trench stair down to the cliff path under the bridge -> the Barbican
// cistern (L15) -> the cistern's stair -> the forecourt -> the gatehouse lever -> the inner arch
// -> the Lower Ward -> the foot of the keep stair (two Gray Knights stand there). Every walk
// between two Lanterns is under 45 seconds at run speed (world_state/castle_tests.rs).
//
// THE BRIDGE AND THE SKIP. The bridge (z 0..60) is B03's arena; its fog gate is the plane
// z = 3.5 between the two pylons. The cliff path (a shelf at -8 m under the deck) lets the
// player skip Corvane. Both ways end at the Barbican's gatehouse, whose south face is two doors
// side by side across the bridge's north end:
//   - door_postern (one-way, opens from the bridge): the way in for a player who beat B03;
//   - gate_main (locked): the main gate. The gatehouse lever, just inside, opens it, and the
//     bridge is then the first shortcut from the Barbican back to L14.
// B03 (Bridgewarden Corvane, WP-071) waits mid-span; the Boss entity is below, in B03's arena.
//
// PART 2 (WP-065) continues north from the keep landing at (0, 6, 218). The stair climbs on to
// the third tier, a terrace at y 12 (terrain.ron): the windward court with L16 at its south end,
// the archers' perches on both walls, a Gray Knight Captain at the east end, the lift cage in the
// bastion over the Lower Ward's north end (the second shortcut: its door opens only from
// inside, so the cage is opened from the court first), and the keep. Two routes reach the
// library (y 18): through the keep's door, the dining hall (Husk servants sleep until the feast
// on the high table is taken: the castle's one ambush), and the dining stair; or up the west
// rampart stair along the keep's wall to the library's west door. The library's north door leads
// to the bell tower (two turns of a stair around an open well up to the belfry, 26 m above the
// court) and, past it, to a corridor that descends to the antechamber (L17) and B07's fog gate.
// A hollow wall on the library's east wall (a faint hum, then a hit) opens the Boo alcove.
//
// THE HALL. B07's fog gate is the plane z = 340 across the gap in the antechamber's north wall
// (x -4..4), opening north into the hall. Castellan Voss has no boss definition yet (M7), so no
// Boss entity is placed, and the back gate toward Rimeshelf is a flag-keyed door: `gate_castle_back`
// is Locked, and it opens when the world raises the flag `door.gate_castle_back.open`. M7's B07
// raises it when Voss falls (alongside `boss.<id>.defeated`); nothing else opens it.
//
// Registry numbers used here (25000 block): castle 25000. Part 2 (26000 block): itm_lost_folio
// 26001, relic_boo 26010, chronicle_page_3 26011 (all stubs).
(
  // The arrival road, south-west of the plaza, facing the bridge.
  spawn: (pos: (-20.0, 0.0, -62.0), yaw: 0.2187),
  entities: [
    // --- Lanterns: L14 and L15 here; L16 and L17 are part 2's, below --------------------------
    // L14 stands 30 m from B03's fog gate; L15 is in the cistern, at the cliff path's end.
    Lantern(id: "lantern_l14", pos: (-12.0, 0.0, -26.0), yaw: 0.0),
    Lantern(id: "lantern_l15", pos: (-4.0, -8.0, 74.0), yaw: 1.5707964),

    // --- Doors and the lever: the Barbican's main gate and postern -----------------------------
    Door(id: "gate_main", pos: (1.0, 0.0, 62.5), yaw: 3.1415927, half_width_m: 3.0, height_m: 5.0, kind: Locked),
    Door(id: "door_postern", pos: (-3.0, 0.0, 62.5), yaw: 3.1415927, half_width_m: 1.0, height_m: 5.0, kind: OneWay),
    Lever(id: "lever_gate_main", pos: (-3.0, 0.0, 75.0), yaw: 0.0, target: Door("gate_main")),
    // The wall-walk's ladder, on the west wall's inner face (the wall-walk is the rampart route
    // WP-065 continues).
    Ladder(id: "ladder_wall_west", pos: (-47.4, 0.0, 130.0), yaw: -1.5707964, height_m: 7.0),

    // --- Authored messages -----------------------------------------------------------------------
    Message(id: "msg_castle_arrive", pos: (-18.0, 0.0, -58.0),
      text: "Castle Graymantle, three tiers of gray stone on a sea cliff. The road runs north to the bridge. The wind off the water smells of salt and old iron."),
    Message(id: "msg_bridge", pos: (-9.0, 0.0, -23.0),
      text: "Graymantle Bridge. A knight in gray holds it, they say: Corvane, who fenced every traveler who tried to cross. A stair cut into the cliff beside the bridge runs down under its deck."),
    Message(id: "msg_cliff_path", pos: (-1.5, 0.0, -21.5),
      text: "The cliff path. It runs under the bridge, narrow, with the sea far below. It ends at the Barbican's cistern. Mind the edge."),
    Message(id: "msg_cistern", pos: (3.0, -8.0, 64.5),
      text: "The Barbican cistern. A stair at the east wall climbs to the courtyard. The gatehouse lever is up there, by the main gate."),
    Message(id: "msg_gate", pos: (-1.0, 0.0, 77.0),
      text: "The main gate bars the bridge from this side. The lever beside it lifts the bar. Once it is open, the road back to the Lantern across the bridge is short."),
    Message(id: "msg_ward", pos: (-3.0, 0.0, 118.0),
      text: "The Lower Ward. A kennel on the west, an armory on the east, a chapel beyond it. A ladder climbs to the wall-walk. The main stair to the keep is straight ahead, and it is guarded."),
    Message(id: "msg_armory", pos: (21.0, 0.0, 134.0),
      text: "The armory. Racks of gray plate and greatshields. One chest here sits crooked: its latch is on the wrong side."),
    Message(id: "msg_ballista", pos: (-45.5, 0.0, 144.0),
      text: "A ballista crouches on the wall above, its bolts rusted in the rack. The wall-walk is reached by the ladder to the north, and it leads on, past the archers, toward the ramparts."),
    Message(id: "msg_keep_stair", pos: (0.0, 0.0, 188.0),
      text: "The stair to the keep. Two Gray Knights keep it. Their shields are high, so strike low and wide, or bash the guard open."),

    // --- Enemies: Husk Servants (the castle's husks), Gray Knights, Thorn Hounds, Acolytes, the Mimic, an Archer
    // The plaza: two Servants walk the road in plain sight before anything else is met.
    Enemy(name: "servant_plaza_a", enemy: "husk_servant", pos: (6.0, 0.0, -48.0), yaw: 3.1415927),
    Enemy(name: "servant_plaza_b", enemy: "husk_servant", pos: (-4.0, 0.0, -40.0), yaw: 3.1415927),
    // The cliff path: a lone Servant on the shelf (the path is narrow, the fight is close).
    Enemy(name: "servant_path", enemy: "husk_servant", pos: (0.0, -8.0, 30.0), yaw: 3.1415927),
    // The cistern: two Servants among the pillars.
    Enemy(name: "servant_cistern_a", enemy: "husk_servant", pos: (-8.0, -8.0, 70.0), yaw: 0.7854),
    Enemy(name: "servant_cistern_b", enemy: "husk_servant", pos: (9.0, -8.0, 66.0), yaw: 3.1415927),
    // The forecourt: a Gray Knight guards the west alcove's Wick Bead (off the route); two
    // Servants walk the yard; one more sits in the guard room.
    Enemy(name: "knight_alcove", enemy: "gray_knight", pos: (-24.0, 0.0, 108.0), yaw: 1.5707964),
    Enemy(name: "servant_fore_a", enemy: "husk_servant", pos: (16.0, 0.0, 98.0), yaw: 3.1415927),
    Enemy(name: "servant_fore_b", enemy: "husk_servant", pos: (-4.0, 0.0, 100.0), yaw: 3.1415927),
    Enemy(name: "servant_guard_room", enemy: "husk_servant", pos: (20.0, 0.0, 70.0), yaw: 3.1415927),
    // The Lower Ward: the kennel's three Thorn Hounds (west), two Servants in the yard, the
    // Chapel Acolytes (north-east), the Mimic (armory), an Archer on the wall by the ballista, and
    // the two Gray Knights at the keep stair.
    Enemy(name: "hound_kennel_a", enemy: "thorn_hound", pos: (-34.0, 0.0, 128.0), yaw: 1.5707964),
    Enemy(name: "hound_kennel_b", enemy: "thorn_hound", pos: (-36.0, 0.0, 132.0), yaw: 1.5707964),
    Enemy(name: "hound_kennel_c", enemy: "thorn_hound", pos: (-33.0, 0.0, 138.0), yaw: 1.5707964),
    Enemy(name: "servant_ward_a", enemy: "husk_servant", pos: (-8.0, 0.0, 134.0), yaw: 3.1415927),
    Enemy(name: "servant_ward_b", enemy: "husk_servant", pos: (10.0, 0.0, 162.0), yaw: 3.1415927),
    Enemy(name: "acolyte_chapel_a", enemy: "acolyte", pos: (33.0, 0.0, 176.0), yaw: -1.5707964),
    Enemy(name: "acolyte_chapel_b", enemy: "acolyte", pos: (37.0, 0.0, 166.0), yaw: -1.5707964),
    Enemy(name: "mimic_armory", enemy: "mimic_chest", pos: (31.0, 0.0, 134.0), yaw: -1.5707964),
    Enemy(name: "archer_wall", enemy: "gray_archer", pos: (-50.0, 7.0, 140.0), yaw: 1.5707964),
    Enemy(name: "knight_stair_w", enemy: "gray_knight", pos: (-9.0, 0.0, 194.0), yaw: 3.1415927),
    Enemy(name: "knight_stair_e", enemy: "gray_knight", pos: (9.0, 0.0, 194.0), yaw: 3.1415927),

    // --- Items, relics, and materials (docs/game/04-arsenal-and-builds.md) ----------------------
    // The cliff path and the cistern.
    Pickup(id: "vial_cliff_path", item: "itm_glimmer_vial", pos: (0.0, -8.0, 50.0), interact: true),
    Pickup(id: "oil_cistern", item: "itm_spark_oil", pos: (-12.0, -8.0, 64.0), count: 2, interact: true),
    Chest(id: "chest_cistern", pos: (-12.5, -8.0, 88.0), yaw: 1.5707964, loot: (item: "itm_forgeglass_shard", count: 3, glimmer: 200)),
    // The guard room (the east tower): the Castle Kite Shield and the Bulwark Charm.
    Pickup(id: "wpn_castle_kite_guard", item: "wpn_castle_kite", pos: (22.5, 0.0, 67.0), interact: true),
    Pickup(id: "chm_bulwark_guard", item: "chm_bulwark", pos: (27.5, 0.0, 70.5), interact: true),
    // The forecourt: a Wick Bead in the west alcove (the knight guards it), a chest by the east wall.
    Pickup(id: "bead_alcove", item: "itm_wick_bead", pos: (-27.0, 0.0, 106.0), interact: true),
    Chest(id: "chest_forecourt", pos: (26.0, 0.0, 84.0), yaw: -1.5707964, loot: (item: "itm_pitch_oil", count: 3, glimmer: 250)),
    // The Lower Ward: Whisperfang near the ladder's foot, the Morning Star in the kennel, the Gray
    // Halberd in the guard post, the armory's racks (Graymantle Plate, the Ox Charm, and the
    // Graymantle Greatshield on the dais past the Mimic), the Steadfast scroll at the chapel's
    // altar, and a chest on the item ledge below the wall-walk.
    Pickup(id: "wpn_whisperfang_ward", item: "wpn_whisperfang", pos: (-44.5, 0.0, 127.0), interact: true),
    Pickup(id: "wpn_morning_star_kennel", item: "wpn_morning_star", pos: (-41.5, 0.0, 139.5), interact: true),
    Pickup(id: "wpn_gray_halberd_post", item: "wpn_gray_halberd", pos: (-42.0, 0.0, 196.0), interact: true),
    Pickup(id: "arm_graymantle_body_armory", item: "arm_graymantle_body", pos: (36.0, 0.0, 146.5), interact: true),
    Pickup(id: "arm_graymantle_head_armory", item: "arm_graymantle_head", pos: (40.0, 0.0, 146.5), interact: true),
    Pickup(id: "chm_ox_armory", item: "chm_ox", pos: (43.5, 0.0, 124.0), interact: true),
    Pickup(id: "wpn_graymantle_greatshield_armory", item: "wpn_graymantle_greatshield", pos: (43.5, 0.3, 135.0), interact: true),
    Pickup(id: "spl_steadfast_chapel", item: "spl_steadfast", pos: (40.5, 0.0, 174.0), interact: true),
    Chest(id: "chest_ledge", pos: (-45.0, 2.5, 165.0), yaw: 1.5707964, loot: (item: "itm_forgeglass_shard", count: 2, glimmer: 400)),

    // --- B03's arena: Graymantle Bridge (x -6..6, z 0..60) -----------------------------------
    // The boss: Bridgewarden Corvane (WP-071). The fog gate is the plane z = 3.5 across the deck,
    // between the two pylons, opening north along the bridge; Corvane waits mid-span facing south.
    // L14 is about 30 m from the gate. The Echo Stone stands just inside the gate, on the west
    // side of the deck.
    Boss(name: "b03", boss: "b03_bridgewarden_corvane", pos: (0.0, 0.0, 32.0), yaw: 3.1415927,
      gate: (pos: (0.0, 0.0, 3.5), yaw: 0.0, half_width_m: 6.0, depth_m: 3.0)),
    EchoStone(id: "stone_b03", pos: (-4.5, 0.0, 9.0), yaw: 0.4),

    // =========================================================================================
    // PART 2 (WP-065): the ramparts, the keep, the library, the bell tower, the hall
    // =========================================================================================

    // --- Lanterns: L16 on the windward court, L17 in the antechamber ----------------------------
    // L16 is a few steps from the top of the keep stair; L17 is 11 m from B07's fog gate.
    Lantern(id: "lantern_l16", pos: (-5.0, 12.0, 245.0), yaw: 0.0),
    Lantern(id: "lantern_l17", pos: (2.0, 12.0, 330.0), yaw: 0.0),

    // --- Doors, the lift, levers, the ladder, the hollow wall ----------------------------------
    // The castle's back gate toward Rimeshelf: shut until the world raises `door.gate_castle_back.open`.
    Door(id: "gate_castle_back", pos: (0.0, 12.0, 385.0), yaw: 3.1415927, half_width_m: 3.0, height_m: 6.5, kind: Locked),
    // The second shortcut: a lift from the court down to the Lower Ward. The cage's door opens
    // only from inside (it faces north), so the shortcut opens from the far side.
    Lift(id: "lift_rampart", pos: (18.0, 203.0), bottom_y: 0.0, top_y: 12.0, half_extents: (2.2, 2.2)),
    Door(id: "door_lift_cage", pos: (18.0, 0.0, 200.5), yaw: 0.0, half_width_m: 2.25, height_m: 3.0, kind: OneWay),
    Lever(id: "lever_lift_top", pos: (18.0, 12.0, 206.0), yaw: 3.1415927, target: Lift(id: "lift_rampart", stop: 1)),
    Lever(id: "lever_lift_bottom", pos: (18.0, 0.0, 204.4), yaw: 3.1415927, target: Lift(id: "lift_rampart", stop: 0)),
    // The library's upper shelf: the gallery along the south wall (y 22).
    Ladder(id: "ladder_gallery", pos: (-10.0, 18.0, 268.95), yaw: 3.1415927, height_m: 4.0),
    // The east wall of the library, behind the last bookcase: a hit reveals the Boo alcove.
    HollowWall(id: "wall_library_boo", center: (27.0, 20.0, 273.0), half_extents: (1.0, 2.0, 1.5)),

    // --- Authored messages ------------------------------------------------------------------------
    Message(id: "msg_court", pos: (-2.0, 12.0, 250.0),
      text: "The windward court, the castle's third tier. The wind comes straight off the sea. Archers hold a perch on each wall, and a captain in gray plate keeps the east end. The keep's door stands ahead. A stair along its west wall climbs to the library's other door."),
    Message(id: "msg_lift", pos: (13.0, 12.0, 210.0),
      text: "A lift cage hangs in the corner of the bastion. Its door opens only from inside. Ride it down once and the Lower Ward is a short walk from the Lantern at the bridge."),
    Message(id: "msg_keep_door", pos: (0.0, 12.0, 260.0),
      text: "The keep. The dining hall lies inside, and above it the library. The scholars say a table is still laid."),
    Message(id: "msg_dining", pos: (0.0, 12.0, 266.0),
      text: "A feast no one finished. The servants at the benches have sat a long time. The best of the table lies on the high board, and they do not like it taken."),
    Message(id: "msg_library", pos: (-23.8, 18.0, 283.6),
      text: "The Graymantle library. The shelves are in order and the readers are not. A ladder at the south wall climbs to the upper shelf. A faint hum comes from the east wall, behind the last case. The north door leads on to the bell tower and the Castellan's hall."),
    Message(id: "msg_hum", pos: (24.5, 18.0, 273.0),
      text: "A faint hum, behind this wall."),
    Message(id: "msg_bell_tower", pos: (-18.8, 18.0, 290.4),
      text: "The bell tower. The stair winds twice around an open well to the belfry. The bell cracked long ago, and the wind plays what is left. A scroll on the belfry floor teaches a parry for weapons that cannot parry."),
    Message(id: "msg_antechamber", pos: (-3.0, 12.0, 324.0),
      text: "The Castellan's antechamber. The hall lies through the gap in the north wall. Voss has fought every duel in this castle, and he remembers all of them. Vary your play."),
    Message(id: "msg_back_gate", pos: (-6.0, 12.3, 381.0),
      text: "The back gate stays shut while the Castellan lives. Beyond it the road climbs to Rimeshelf."),
    Message(id: "msg_pass", pos: (0.0, 12.0, 392.0),
      text: "The pass north. Snow has drifted against the wall, and the wind is colder."),

    // --- Enemies: the ramparts' archers, captain, and flank knight; the dining hall's ambush; a reader --------
    // The perches: two Gray Archers on four-meter platforms, facing the court (30 m of sight).
    Enemy(name: "archer_perch_w", enemy: "gray_archer", pos: (-41.0, 16.0, 247.0), yaw: 1.5707964),
    Enemy(name: "archer_perch_e", enemy: "gray_archer", pos: (41.0, 16.0, 247.0), yaw: -1.5707964),
    // The elite: the captain keeps the court's east end, with the bastion and its lift cage to the south-west.
    Enemy(name: "captain_rampart", enemy: "gray_captain", pos: (34.0, 12.0, 238.0), yaw: -1.5707964),
    // A Gray Knight at the foot of the west rampart stair.
    Enemy(name: "knight_flank_w", enemy: "gray_knight", pos: (-40.0, 12.0, 272.0), yaw: 3.1415927),
    // The dining hall's ambush: Husk servants asleep at the east benches until the feast is taken (kept off the west aisle and the library's walking lane above).
    Enemy(name: "servant_dining_a", enemy: "husk_servant", pos: (11.0, 12.0, 267.0), yaw: -1.5707964, wakes_on: Some("pickup.chunk_dining.taken")),
    Enemy(name: "servant_dining_b", enemy: "husk_servant", pos: (11.0, 12.0, 273.5), yaw: -1.5707964, wakes_on: Some("pickup.chunk_dining.taken")),
    Enemy(name: "servant_dining_c", enemy: "husk_servant", pos: (17.5, 12.0, 267.0), yaw: 3.1415927, wakes_on: Some("pickup.chunk_dining.taken")),
    Enemy(name: "servant_dining_d", enemy: "husk_servant", pos: (17.5, 12.0, 273.5), yaw: 3.1415927, wakes_on: Some("pickup.chunk_dining.taken")),
    // A reader in the library's south-east corner, off the way between the two doors.
    Enemy(name: "servant_library", enemy: "husk_servant", pos: (14.0, 18.0, 269.0), yaw: 3.1415927),

    // --- Items, relics, materials, key items (docs/game/04-arsenal-and-builds.md) ----------------
    // The ramparts: Flask Dew beside the library's west door, the Parrier's Eye on the east perch
    // (the archer stands by it), the captain's Gray Knight Greatsword, and a chest on the west wall.
    Pickup(id: "dew_rampart", item: "itm_flask_dew", pos: (-31.0, 18.0, 287.0), interact: true),
    Pickup(id: "chm_parriers_eye_perch", item: "chm_parriers_eye", pos: (41.0, 16.0, 249.5), interact: true),
    Pickup(id: "wpn_gray_greatsword_rampart", item: "wpn_gray_greatsword", pos: (36.0, 12.0, 234.0), interact: true),
    Chest(id: "chest_court", pos: (-45.5, 12.0, 233.0), yaw: 1.5707964, loot: (item: "itm_forgeglass_shard", count: 3, glimmer: 300)),
    // The keep: the feast on the high table (taking it wakes the benches) and a chest by the door.
    Pickup(id: "chunk_dining", item: "itm_forgeglass_chunk", pos: (0.0, 12.0, 282.4), count: 2, interact: true),
    Chest(id: "chest_dining", pos: (22.0, 12.0, 266.0), yaw: 3.1415927, loot: (item: "itm_forgeglass_chunk", count: 1, glimmer: 350)),
    // The library: the Gradient Rod on the reading desk, two Formulae in the aisle, the Rewrite
    // Quill on the upper shelf (the gallery), a Lost Folio in the east nook, and, behind the
    // hollow wall, the Boo relic (portfolio: boo).
    Pickup(id: "wpn_gradient_rod_library", item: "wpn_gradient_rod", pos: (0.0, 18.0, 278.2), interact: true),
    Pickup(id: "spl_homing_motes_library", item: "spl_homing_motes", pos: (-10.0, 18.0, 275.5), interact: true),
    Pickup(id: "spl_aether_wave_library", item: "spl_aether_wave", pos: (10.0, 18.0, 275.5), interact: true),
    Pickup(id: "quill_gallery", item: "itm_rewrite_quill", pos: (-4.0, 22.0, 266.5), interact: true),
    Pickup(id: "folio_library", item: "itm_lost_folio", pos: (20.0, 18.0, 270.0), interact: true),
    Pickup(id: "relic_boo", item: "relic_boo", pos: (30.5, 18.0, 272.5), codex: Some("projects.boo"), interact: true),
    // The bell tower's belfry: the Windward Parry Art Scroll.
    Pickup(id: "scroll_windward_parry", item: "itm_art_scroll_windward_parry", pos: (-14.0, 38.0, 291.0), interact: true),
    // The Castellan's desk (the hall's north dais): Chronicle Page slot 3 and the Gradient Descent
    // Formula. They lie behind the fight, at the far end of the hall.
    Pickup(id: "page_chronicle_3", item: "chronicle_page_3", pos: (0.0, 12.3, 378.2), codex: Some("work.american-express"), interact: true),
    Pickup(id: "spl_gradient_descent_desk", item: "spl_gradient_descent", pos: (-3.0, 12.3, 378.2), interact: true),

    // --- B07's arena: Castellan's Hall (x -22..22, z 342..384) ------------------------------------
    // The boss: PLACEHOLDER. B07 (Castellan Voss, an M7 work package) has no boss definition yet,
    // so no Boss entity is placed. When it exists, add:
    //   Boss(name: "b07", boss: "<b07 id>", pos: (0.0, 12.0, 364.0), yaw: 3.1415927,
    //     gate: (pos: (0.0, 12.0, 340.0), yaw: 0.0, half_width_m: 4.0, depth_m: 3.0)),
    // The fog gate is the plane z = 340 across the gap in the antechamber's north wall, opening
    // north; Voss waits mid-hall facing south. L17 is about 10 m from the gate. The Echo Stone
    // stands just inside it, by the west wall. M7 also raises `door.gate_castle_back.open` when he falls.
    EchoStone(id: "stone_b07", pos: (-10.0, 12.0, 346.0), yaw: 0.5),
  ],
)
