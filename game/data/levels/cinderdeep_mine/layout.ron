    (name: "gallery_post_w1", kit: "block_unit", pos: (-5.20, -9.29, 8.00), scale: (0.80, 5.00, 0.80)),
    (name: "gallery_post_e1", kit: "block_unit", pos: (5.20, -9.29, 8.00), scale: (0.80, 5.00, 0.80)),
    (name: "gallery_beam1", kit: "block_unit", pos: (0.00, -6.39, 8.00), scale: (11.20, 0.80, 1.00)),
    (name: "gallery_post_w2", kit: "block_unit", pos: (-5.20, -16.36, 44.00), scale: (0.80, 5.00, 0.80)),
