// Drowned Belfry (WP-061, D3): a sunken bell tower off Stillwater Village's shore, 100 x 146 m.
// Y is up. Its signature mechanic is the bell: ringing it stuns the enemies near it and opens
// doors, among them the gate of the bell-shaft lift, which descends to Hollowdeep's Fungal
// Shore. The Choir Knight at the end guards the sluice lever that drains Mirrormere's lake.
// See docs/game/02-world.md, "Mini-dungeons", and the notes at the top of layout.ron and
// entities.ron. L07 (Stillwater Village) stands outside.
(
  id: "drowned_belfry",
  name: "Drowned Belfry",
  seed: 20261303,
  bounds: (min: (-48.0, -84.0), max: (52.0, 62.0)),
  kill_y: -50.0,
  start_glimmer: 0,
  // A damp, blue-grey ruin under a pale sky.
  ambient: (
    sky: "night",
    fog_color: (0.06, 0.09, 0.11),
    fog_near_m: 30.0,
    fog_far_m: 140.0,
    sun_dir: (-0.25, -1.0, -0.15),
    sun_color: (0.62, 0.78, 0.92),
    sun_intensity: 0.45,
    ambient_color: (0.5, 0.6, 0.7),
    ambient_intensity: 0.7,
  ),
  // Up the stair to Stillwater Village's shore, and down the bell shaft to Hollowdeep.
  connections: [
    (to: "mirrormere", pos: (0.0, 0.0, -81.0), radius_m: 3.0),
    (to: "hollowdeep", pos: (30.0, -12.0, 9.0), radius_m: 3.0),
  ],
)
