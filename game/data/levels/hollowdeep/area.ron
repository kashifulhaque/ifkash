// Hollowdeep (WP-062): the underground region, 300 x 300 m. Y is up. The Cinderdeep Mine's tunnel
// opens in the south-west corner; the Lantern chain runs L11 Fungal Shore -> L12 Glasswing Mouth
// -> L13 Lamplight Hollow. See docs/game/02-world.md, "Hollowdeep", and the notes at the top of
// terrain.ron, layout.ron, and entities.ron.
(
  id: "hollowdeep",
  name: "Hollowdeep",
  seed: 20261303,
  bounds: (min: (-150.0, -150.0), max: (150.0, 150.0)),
  kill_y: -60.0,
  start_glimmer: 0,
  // Near-black with a violet cast; the glowing zones read as bioluminescent cyan. The renderer
  // narrows the fog to the player's visibility outside them (render/lighting/darkness.ts).
  ambient: (
    sky: "night",
    fog_color: (0.03, 0.03, 0.07),
    fog_near_m: 60.0,
    fog_far_m: 260.0,
    sun_dir: (-0.2, -1.0, -0.2),
    sun_color: (0.45, 0.6, 0.85),
    sun_intensity: 0.25,
    ambient_color: (0.3, 0.38, 0.55),
    ambient_intensity: 0.5,
  ),
  regions: [
    // The Fungal Shore, the west bank of the lake.
    (name: "shore", points: [(-96.0, -126.0), (-30.0, -126.0), (-30.0, -30.0), (-96.0, -30.0)]),
    // The north shore, from the west passage to the Glasswing Mouth and on east.
    (name: "north_shore", points: [(-90.0, 40.0), (66.0, 40.0), (66.0, 72.0), (-90.0, 72.0)]),
    // The Lamp Tree's island.
    (name: "tree_island", points: [(5.0, -70.0), (45.0, -70.0), (45.0, -30.0), (5.0, -30.0)]),
    // The Lamplight antechamber and the arena beyond it.
    (name: "lamplight", points: [(78.0, 48.0), (146.0, 48.0), (146.0, 146.0), (78.0, 146.0)]),
  ],
  connections: [
    // Back up the Cinderdeep Mine's tunnel (the arrival cave's west wall).
    (to: "cinderdeep_mine", pos: (-144.0, 0.0, -128.0), radius_m: 2.5),
    // The Drowned Belfry's bell-shaft lift lands on the Fungal Shore (WP-061).
    (to: "drowned_belfry", pos: (-90.0, 0.0, -50.0), radius_m: 2.5),
    // The Mossgut Cave lift lands in an alcove off the west passage (WP-063).
    (to: "mossgut_cave", pos: (-98.0, 0.0, 18.0), radius_m: 2.5),
    // Glasswing Grotto (D5, WP-063), north of L12.
    (to: "glasswing_grotto", pos: (-16.0, 0.0, 98.0), radius_m: 2.5),
    // The Root Stair's trapdoor, up to the Spire's underside beside L22 (WP-067).
    (to: "spire", pos: (148.6, 24.0, -34.0), radius_m: 1.2),
  ],
)
