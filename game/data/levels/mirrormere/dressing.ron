// The Mirrormere dressing: render-only scatter (no rule adds colliders). Dead grass on the
// shores, dead trees and stones in the marsh.
(
  rules: [
    (
      tag: "ash_grass",
      density: 0.012,
      min_spacing: 1.5,
      max_slope_deg: 30.0,
      avoid: [Path(width: 6.0), Lantern(radius: 3.0), Spawn(radius: 2.0), Layout(margin: 1.0)],
      region_mask: Some("shore_w"),
      scale: (0.8, 1.3),
    ),
    (
      tag: "ash_grass",
      density: 0.012,
      min_spacing: 1.5,
      max_slope_deg: 30.0,
      avoid: [Path(width: 6.0), Lantern(radius: 3.0), Spawn(radius: 2.0), Layout(margin: 1.0)],
      region_mask: Some("shore_s"),
      scale: (0.8, 1.3),
    ),
    (
      tag: "ash_grass",
      density: 0.012,
      min_spacing: 1.5,
      max_slope_deg: 30.0,
      avoid: [Path(width: 6.0), Lantern(radius: 3.0), Spawn(radius: 2.0), Layout(margin: 1.0)],
      region_mask: Some("shore_n"),
      scale: (0.8, 1.3),
    ),
    (
