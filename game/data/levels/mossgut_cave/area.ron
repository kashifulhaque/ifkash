// Mossgut Cave (WP-063, D1): the Verge's cave under the rock behind L05 (Mossgut Mouth), 128 x
// 200 m. Y is up and the cave runs north (+Z). Its signature mechanic is the low ceiling: every
// room but the mouth hall is 2.0 m high, so an overhead swing strikes the rock and the fight is
// thrusts and horizontal swings. B04 (the Mossgut Brood, an M7 work package) waits in the last
// chamber, behind a fog gate; past it is the Fungal Knife and the lift down to Hollowdeep. See
// docs/game/02-world.md, "Mini-dungeons" (D1), and the notes at the top of terrain.ron,
// layout.ron, and entities.ron. L05 (Mossgut Mouth) stands outside, in the Verge.
(
  id: "mossgut_cave",
  name: "Mossgut Cave",
  seed: 20261304,
  bounds: (min: (-64.0, -100.0), max: (64.0, 100.0)),
  kill_y: -60.0,
  start_glimmer: 0,
  // A close, damp cave lit by fungus: green-brown fog that shuts in quickly.
  ambient: (
    sky: "night",
    fog_color: (0.05, 0.08, 0.05),
    fog_near_m: 14.0,
    fog_far_m: 70.0,
    sun_dir: (-0.2, -1.0, -0.2),
    sun_color: (0.55, 0.8, 0.5),
    sun_intensity: 0.35,
    ambient_color: (0.45, 0.62, 0.42),
    ambient_intensity: 0.65,
  ),
  regions: [
    // The Low Gallery and the Spore Hall.
    (name: "galleries", points: [(-15.0, -72.0), (15.0, -72.0), (15.0, -14.0), (-15.0, -14.0)]),
    // The Brood Warren and the chamber beyond it.
    (name: "brood", points: [(-16.0, -10.0), (16.0, -10.0), (16.0, 88.0), (-16.0, 88.0)]),
  ],
  connections: [
    // Back out to the Verge: the cave mouth under L05.
    (to: "verge", pos: (0.0, 0.0, -98.0), radius_m: 2.5),
    // Down the lift to Hollowdeep: the pit's floor, east of the platform's bottom stop. It lands in
    // the alcove off Hollowdeep's west passage.
    (to: "hollowdeep", pos: (50.0, -18.0, 59.0), radius_m: 2.5),
  ],
)
