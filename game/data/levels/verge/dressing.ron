// The Verge dressing: render-only scatter (no rule adds colliders). Dead grass and stones
// over the meadow, dead trees thick in the Briar Thicket.
(
  rules: [
    (
      tag: "ash_grass",
      density: 0.012,
      min_spacing: 1.5,
      max_slope_deg: 30.0,
      avoid: [Path(width: 6.0), Lantern(radius: 3.0), Spawn(radius: 2.0), Layout(margin: 1.0)],
      region_mask: Some("meadow"),
      scale: (0.8, 1.3),
    ),
    (
      tag: "stone",
      density: 0.003,
      min_spacing: 4.0,
      max_slope_deg: 25.0,
      avoid: [Path(width: 4.0), Lantern(radius: 3.0), Layout(margin: 1.0)],
      region_mask: Some("meadow"),
      scale: (0.6, 1.6),
    ),
    (
      tag: "dead_tree",
      density: 0.004,
      min_spacing: 5.0,
      max_slope_deg: 25.0,
      avoid: [Path(width: 8.0), Lantern(radius: 4.0), Spawn(radius: 3.0), Layout(margin: 2.0)],
      region_mask: Some("thicket"),
      scale: (0.9, 1.4),
    ),
  ],
)
