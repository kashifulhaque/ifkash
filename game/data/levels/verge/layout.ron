    (name: "crypt_s", kit: "block_unit", pos: (114.0, 1.5, 40.0), scale: (16.0, 3.0, 1.0)),
    (name: "crypt_n", kit: "block_unit", pos: (114.0, 1.5, 52.0), scale: (16.0, 3.0, 1.0)),
