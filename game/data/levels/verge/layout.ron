    (name: "pier_ew2_79", kit: "block_unit", pos: (79.0, 2.75, 50.0), scale: (2.0, 5.5, 4.0)),

    // --- Ninefold Chapel: a roofless ring, 4 m walls, one gate in the south ----------------
    (name: "chapel_s_w", kit: "block_unit", pos: (80.0, 2.0, 30.0), scale: (12.0, 4.0, 1.0)),
