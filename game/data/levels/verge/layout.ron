    (name: "pier_ns_-12", kit: "block_unit", pos: (66.0, 2.75, -12.0), scale: (4.0, 5.5, 2.0)),
    (name: "pier_ns_-2", kit: "block_unit", pos: (66.0, 2.75, -2.0), scale: (4.0, 5.5, 2.0)),
    (name: "pier_ns_26", kit: "block_unit", pos: (66.0, 2.75, 26.0), scale: (4.0, 5.5, 2.0)),
