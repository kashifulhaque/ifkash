// The Verge layout (WP-044): greybox blocks (scaled `block_unit`, centered on `pos`).
// Y is up; the ground is 0 m except the Windmill Rise (flat top at 10 m) and the aqueduct
// ramp (terrain.ron). Places, with their centers (x, z):
//   hollow mouth      (-110, -120)   the root-door the player steps out of
//   L02 Crossroads    ( -40,  -60)   open meadow; the Spire stands 240 m north of it
//   L03 Aqueduct      (  10,  -30)   foot of the aqueduct ramp
//   aqueduct          ramp x 20..40, then a deck at y = 6: east along z = -30 to x = 68,
//                     north along x = 66 to z = 50, east to the chapel roof platform
//   L04 Ninefold      (  90,   36)   chapel courtyard (x 74..106, z 30..60), crypt to the east
//   L05 Mossgut Mouth ( -20,   56)   a cave mouth in a stone mass at z 64..76
//   Windmill Rise     ( -90,   20)   a 10 m hill; the tower stands on its flat top
//   Briar Thicket     ( 142,  -80)   the B02 arena, x 112..172, z -108..-52; fog gate on its
//                                    west side at x = 112
//   Spire Approach    road north from L05 to the Spire at (-40, 180)
// Walks between Lanterns are checked by the test in world_state/verge_tests.rs.
(
  landmarks: [
    // --- Borders: 6 m walls on the edge of the world -------------------------------------
    (name: "border_n", kit: "block_unit", pos: (0.0, 3.0, 199.0), scale: (400.0, 6.0, 2.0)),
    (name: "border_s", kit: "block_unit", pos: (0.0, 3.0, -199.0), scale: (400.0, 6.0, 2.0)),
    (name: "border_e", kit: "block_unit", pos: (199.0, 3.0, 0.0), scale: (2.0, 6.0, 400.0)),
    (name: "border_w", kit: "block_unit", pos: (-199.0, 3.0, 0.0), scale: (2.0, 6.0, 400.0)),

    // --- The hollow mouth: a stone arch the root-door opened in ---------------------------
    (name: "mouth_jamb_w", kit: "block_unit", pos: (-122.0, 3.0, -126.0), scale: (2.0, 6.0, 2.0)),
    (name: "mouth_jamb_e", kit: "block_unit", pos: (-118.0, 3.0, -128.0), scale: (2.0, 6.0, 2.0)),
    (name: "mouth_lintel", kit: "block_unit", pos: (-120.0, 6.5, -127.0), scale: (6.0, 1.0, 4.0)),
    (name: "mouth_back", kit: "block_unit", pos: (-120.0, 4.0, -133.0), scale: (14.0, 8.0, 4.0)),

    // --- The Spire: a stacked, tapering silhouette, 100 m tall, in the north --------------
    // Visible from L02 (-40, -60) across open meadow: nothing taller than 18 m stands in
    // the strip x = -60..-20 between them.
    (name: "spire_base", kit: "block_unit", pos: (-40.0, 10.0, 182.0), scale: (22.0, 20.0, 22.0)),
    (name: "spire_mid", kit: "block_unit", pos: (-40.0, 40.0, 182.0), scale: (14.0, 40.0, 14.0)),
    (name: "spire_top", kit: "block_unit", pos: (-40.0, 70.0, 182.0), scale: (8.0, 20.0, 8.0)),
    (name: "spire_tip", kit: "block_unit", pos: (-40.0, 90.0, 182.0), scale: (3.0, 20.0, 3.0)),

    // --- The aqueduct ----------------------------------------------------------------------
    // Decks: tops at y = 6.0, 4 m wide.
    (name: "deck_ew1", kit: "block_unit", pos: (54.0, 5.75, -30.0), scale: (28.0, 0.5, 4.0)),
    (name: "deck_ns", kit: "block_unit", pos: (66.0, 5.75, 10.0), scale: (4.0, 0.5, 84.0)),
    (name: "deck_ew2", kit: "block_unit", pos: (74.0, 5.75, 50.0), scale: (20.0, 0.5, 4.0)),
    // Piers, 2 m by 4 m, with 6 m arches between; the north-south leg skips z = 2..23, the
