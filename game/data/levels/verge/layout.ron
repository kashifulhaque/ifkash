    (name: "mill_w", kit: "block_unit", pos: (-93.5, 14.0, 20.0), scale: (1.0, 8.0, 8.0)),
    (name: "mill_e", kit: "block_unit", pos: (-86.5, 14.0, 20.0), scale: (1.0, 8.0, 8.0)),
