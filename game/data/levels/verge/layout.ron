    (name: "closet_s", kit: "block_unit", pos: (126.5, 1.5, 43.0), scale: (9.0, 3.0, 1.0)),
    (name: "closet_n", kit: "block_unit", pos: (126.5, 1.5, 49.0), scale: (9.0, 3.0, 1.0)),
    (name: "closet_e", kit: "block_unit", pos: (130.0, 1.5, 46.0), scale: (1.0, 3.0, 7.0)),

    // --- The Windmill Rise: a tower on the hill's flat top (10 m) -------------------------
    // 8 m square, 8 m walls, a doorway in the south wall, a flat roof at y = 18. A ladder on
