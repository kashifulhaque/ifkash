// Moves for B03, Bridgewarden Corvane (registry 32100-32199). Source:
// docs/game/05-enemies-and-bosses.md, "B03 Bridgewarden Corvane" (a shield advance, a
// three-hit halberd combo with every hit parryable and the third delayed, a sweeping turn,
// and a lunge that punishes healing within 6 m, telegraphed by a shout for 18 ticks). Damage
// comes from the body's `attack`, so `motion_value` is the only multiplier. No hit carries
// `Unparryable`, since Corvane teaches the parry. Every attack telegraphs for at least 12
// frames and every combo ends in at least 20 frames of recovery (checked by
// `lf_content::boss::check`). Hit and frame numbers are tuning. The renderer matches
// choreography on words in `anim` (shield, combo or chain, sweep or turn, lunge or shout).
#![enable(implicit_some)]
[
  (
    // Shield advance: he lifts the shield and steps in 1.6 m behind it, then shoves. 20
    // frames of telegraph; a parry opens him up.
    id: "b03_shield_advance",
    anim: "corvane_shield_advance",
    total_frames: 66,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (8, 0.0), (20, 1.6), (66, 1.6)],
    track_deg_per_tick: 4.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (20, 23),
        shape: Capsule(a: (0.0, 1.1, 0.5), b: (0.0, 1.1, 1.7), radius: 0.7),
        motion_value: 0.8,
        phys: Blunt,
        element: None,
        poise_damage: 35,
        status: [],
        knockback: 1.0,
        hitstop: 5,
        tags: [],
