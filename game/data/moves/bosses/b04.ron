// Moves for B04, the Mossgut Brood (registry 33100-33105). Source:
// docs/game/05-enemies-and-bosses.md, "B04 Mossgut Brood": the mother doesn't move; she spits
// Poison globs (arcing, with a ground marker) and sweeps a tendril at close range; in phase 2
// she tears free and sprays Poison in a cone. Damage comes from the body's `attack`, so
// `motion_value` is the only multiplier. Every attack telegraphs for at least 12 frames and
// every combo ends in at least 20 frames of recovery (checked by `lf_content::boss::check`).
// Hit and frame numbers are tuning. No move has root motion: the mother stays where she is
// (in phase 2 the `Approach` behavior is what crawls her forward).
#![enable(implicit_some)]
[
  (
    // A glob at a player within about 10 m: the mother bloats for 30 frames, a ground marker
    // shows where it will land, and the glob arcs out on frame 30.
    id: "b04_spit_near",
    anim: "b04_spit_near",
    total_frames: 78,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (78, 0.0)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [],
    projectiles: [
      (frame: 30, projectile: "proj_b04_glob", offset: (0.0, 1.3, 1.1), yaw_deg: 0.0, pitch_deg: 10.0),
    ],
    sfx: [(12, "brood_gurgle"), (30, "glob_spit")],
    vfx: [(0, "marker_glob"), (6, "spore_bloat")],
  ),
  (
    // The same spit at a player farther away: a higher arc, about 20 m.
    id: "b04_spit_far",
    anim: "b04_spit_far",
    total_frames: 82,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (82, 0.0)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [],
    projectiles: [
      (frame: 34, projectile: "proj_b04_glob", offset: (0.0, 1.3, 1.1), yaw_deg: 0.0, pitch_deg: 30.0),
    ],
    sfx: [(14, "brood_gurgle"), (34, "glob_spit")],
    vfx: [(0, "marker_glob"), (6, "spore_bloat")],
  ),
  (
    // The tendril sweeps across her front, left to right: a 26-frame wind-up (the tendril
    // draws back and the spores pulse). Roll through it, or stand outside 4 m.
    id: "b04_tendril",
    anim: "b04_tendril",
    total_frames: 54,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (54, 0.0)],
    track_deg_per_tick: 4.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: "b04_tendril_back",
    hitboxes: [
      (
        frames: (26, 30),
        shape: Capsule(a: (-2.4, 0.6, 1.2), b: (2.4, 0.6, 3.0), radius: 0.55),
        motion_value: 1.2,
        phys: Blunt,
        element: None,
        poise_damage: 30,
        status: [],
        knockback: 0.7,
        hitstop: 5,
        tags: [],
      ),
    ],
    projectiles: [],
    sfx: [(18, "tendril_creak"), (26, "tendril_whip")],
    vfx: [(4, "spore_pulse"), (26, "trail_moss")],
  ),
  (
    // The tendril comes back the other way after a shorter wind-up (only the second hit of a
    // combo may come quicker), then a 42-frame recovery to punish.
    id: "b04_tendril_back",
    anim: "b04_tendril_back",
    total_frames: 60,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (60, 0.0)],
    track_deg_per_tick: 4.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (14, 17),
        shape: Capsule(a: (2.4, 0.6, 1.2), b: (-2.4, 0.6, 3.0), radius: 0.55),
        motion_value: 1.0,
        phys: Blunt,
        element: None,
        poise_damage: 25,
        status: [],
        knockback: 0.6,
        hitstop: 4,
        tags: [],
      ),
    ],
    projectiles: [],
    sfx: [(10, "tendril_creak"), (14, "tendril_whip")],
    vfx: [(14, "trail_moss")],
  ),
  (
    // Phase 2: she rears and sprays Poison in a cone about 9.6 m long (the three hitboxes
    // widen along it). A 30-frame wind-up (her cap flushes and a mist gathers); the hit window
    // is 13 frames, the length of a roll's i-frames, so step out of the cone's side or roll.
    id: "b04_spray",
    anim: "b04_spray",
    total_frames: 80,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (80, 0.0)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (30, 42),
        shape: Capsule(a: (0.0, 0.9, 1.0), b: (0.0, 0.9, 3.0), radius: 0.9),
        motion_value: 0.7,
        phys: Neutral,
        element: None,
        poise_damage: 15,
        status: [(kind: Poison, amount: 60)],
        knockback: 0.3,
        hitstop: 3,
        tags: [],
      ),
      (
        frames: (30, 42),
        shape: Capsule(a: (0.0, 0.9, 3.0), b: (0.0, 0.9, 5.5), radius: 1.7),
        motion_value: 0.7,
        phys: Neutral,
        element: None,
        poise_damage: 15,
        status: [(kind: Poison, amount: 60)],
        knockback: 0.3,
        hitstop: 3,
        tags: [],
      ),
      (
        frames: (30, 42),
        shape: Sphere(center: (0.0, 0.9, 7.2), radius: 2.4),
        motion_value: 0.7,
        phys: Neutral,
        element: None,
        poise_damage: 15,
        status: [(kind: Poison, amount: 60)],
        knockback: 0.3,
        hitstop: 3,
        tags: [],
      ),
    ],
    projectiles: [],
    sfx: [(16, "brood_gurgle"), (30, "spray_hiss")],
    vfx: [(0, "marker_cone"), (8, "spore_bloat"), (30, "spray_mist")],
  ),
  (
    // The phase 2 transition: she tears free of the wall. 45 frames, no attack, invulnerable
    // throughout.
    id: "b04_tear_free",
    anim: "b04_tear_free",
    total_frames: 45,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (45, 0.0)],
    track_deg_per_tick: 0.0,
    hyperarmor: None,
    iframes: (from: 0, to: 44),
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [],
    projectiles: [],
    sfx: [(0, "wall_tear"), (20, "brood_roar")],
    vfx: [(0, "aura_phase"), (10, "rock_dust")],
  ),
]
