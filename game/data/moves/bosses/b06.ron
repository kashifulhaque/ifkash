// Moves for B06, the Drowned Choir (registry 35100-35199). Source:
// docs/game/05-enemies-and-bosses.md, "B06 The Drowned Choir". The Cantor: a Radiance beam, a
// close rebuke, a mending hymn (the heal itself is `ai::bosses::b06`), and in the verse a homing
// chorus. The Bellbearer: a bell slam, a two-hit swing, the stun-wave bell ring, and in the verse
// a charge. The Lamenter: Rime knives, a three-cut combo, and in the verse a teleport-stab (the
// teleport itself is `ai::bosses::b06`). Damage comes from each member's `attack`, so
// `motion_value` is the only multiplier. Frame counts and numbers are tuning, bounded by the
// fairness rules (docs "Fairness rules"; checked by `lf_content::boss::check`): every attack
// telegraphs for at least 12 frames, heavy ones for 18 to 36, and every combo ends in at least 20
// frames of recovery.
#![enable(implicit_some)]
[
  // ---- The Cantor ------------------------------------------------------------------------
  (
    // Radiance beam: the Cantor lifts a hand and a thread of light gathers for 30 frames, then
    // lashes a long line out. It stops aiming 4 frames before it fires. Roll sideways.
    id: "b06_cantor_beam",
    anim: "cantor_beam",
    total_frames: 102,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (102, 0.0)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (30, 34),
        shape: Capsule(a: (0.0, 1.3, 0.8), b: (0.0, 1.3, 16.0), radius: 0.45),
        motion_value: 1.5,
        phys: Neutral,
        element: Radiance,
        poise_damage: 18,
        status: [],
        knockback: 0.3,
        hitstop: 3,
        tags: [],
      ),
    ],
    sfx: [(4, "choir_note_rise")],
    vfx: [(4, "radiance_gather"), (30, "radiance_beam")],
  ),
  (
