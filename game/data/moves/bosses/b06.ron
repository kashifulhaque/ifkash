  (
    // Mending hymn: the Cantor raises both arms for 34 frames. If it finishes the verse
    // uninterrupted, the other living members each recover a share of their HP (the heal
    // lands on `mechanics.mend_frame`; a stagger that breaks the move stops it). The hymn ends
    // in a pulse of light around the Cantor, so walking up to break it has a price.
    id: "b06_cantor_mend",
    anim: "cantor_mend",
    total_frames: 104,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (104, 0.0)],
    track_deg_per_tick: 2.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
