// Moves for B12, the Unspooled (registry 41100-41199). Source: docs/game/05-enemies-and-bosses.md,
// "B12 The Unspooled". Frame numbers, reaches, and motion values are tuning; damage comes from the
// body's `attack`, so `motion_value` is the only multiplier. Every first hit has a telegraph of at
// least 18 ticks, every combo ends in a punish window of at least 20 ticks (checked by
// `lf_content::boss::check`), and only second or later hits are delayed.
//
// Phase 1, the Weaver: the thread lash (two lashes, whip reach), the loom lines (`b12_loom`: the
// lines themselves are `lf_core::ai::bosses::b12`'s, laid on the frame in the boss's `params`),
// the stitching grab (a white flash, then an unblockable grab), and the spinning cut.
// Phase 2, the Unspooled: the many-limbed flurry (three strikes), the loom storm (lines both ways),
// the lash and the spin again, and one borrowed move per Great Sigil boss the player defeated (those
// moves stay in their own boss's file; the boss definition names them).
#![enable(implicit_some)]
[
  (
    // Thread lash, first: the right arm draws back for 20 frames with its threads lit, then cracks a thread 6.5 m out like a whip. Chains into the second lash.
    id: "b12_lash",
    anim: "b12_lash",
    total_frames: 34,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (20, 0.0), (24, 0.4), (34, 0.4)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: "b12_lash_2",
    hitboxes: [
      (
        frames: (20, 23),
        shape: Capsule(a: (0.4, 1.4, 0.6), b: (0.0, 0.9, 6.5), radius: 0.4),
        motion_value: 1.2,
        phys: Slash,
        element: None,
        poise_damage: 30,
        status: [],
        knockback: 0.6,
        hitstop: 5,
        tags: [],
      ),
    ],
    sfx: [(12, "thread_draw"), (20, "thread_crack")],
    vfx: [(0, "thread_glow"), (20, "thread_whip")],
  ),
  (
