// Moves for the WP-033 test boss (registry 9200-9299). Not part of the roster: the real
// bosses add their own under moves/bosses/. Each attack telegraphs for at least 12 frames
// and ends in a punish window of at least 20 (docs/game/05-enemies-and-bosses.md,
// "Fairness rules"; checked by `lf_content::boss::check`). The transition move is 45
// frames with i-frames on every frame ("Boss framework", Phases).
#![enable(implicit_some)]
[
  (
    // Phase 1 and 2: a wide forward swipe.
    id: "tb_swipe",
    anim: "boss_swipe",
    total_frames: 60,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (14, 0.0), (18, 0.4), (60, 0.4)],
    track_deg_per_tick: 6.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
