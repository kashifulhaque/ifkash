// Bow moveset (WP-052). Source: docs/game/04-arsenal-and-builds.md, "Weapon classes": ranged, medium speed, 40 m range, Finesse; aim while locked on or free-aim.
// Frame numbers are tuning unless a spec line says otherwise. Dodges (roll, backstep) are
// shared in common.ron; the critical pair is shared in crits.ron, and the weapon's
// crit_mult_percent (100) sets the crit.
// total_frames = startup + active + recovery; a hitbox window is (startup, startup + active - 1).
// Schema: crates/content/src/moves.rs.
#![enable(implicit_some)]
[
  (
    // LIGHT: a quick arrow from the chest. Locked on, the move turns toward the lock target until the
    // arrow leaves; with no lock target, the stick aims it (free_aim, combat/bow.rs).
    id: "bow_shot",
    anim: "bow_shoot",
    total_frames: 26,
    stamina: 6,
    fp: 0,
    root_motion: [],
    track_deg_per_tick: 12.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: 18,
    cancel_dodge_from: 13,
    cancel_any_from: 20,
    next_chain: None,
    free_aim: true,
    hitboxes: [
    ],
    projectiles: [
      (frame: 9, projectile: "proj_arrow", offset: (0.0, 1.4, 0.5), yaw_deg: 0.0, pitch_deg: 0.0),
    ],
    sfx: [(8, "bow_release")],
    vfx: [],
  ),
  (
    // HEAVY tap: a drawn shot. The heavy arrow hits harder and flies faster. Aims like bow_shot.
    id: "bow_heavy",
