// Enemy moves for WP-036 (the Bell Acolyte). Registry numbers 8302. Schema:
// crates/content/src/moves.rs. Every attack telegraphs for at least 12 frames before its
// first active hitbox frame or projectile (docs/game/05-enemies-and-bosses.md, "Enemy
// roster"; checked by the validator). Damage comes from the enemy's `attack` (and
// `element_attack`) in enemies/*.ron, so `motion_value` is the only multiplier here. Numbers
// are tuning.
#![enable(implicit_some)]
[
  (
    // The cast: a 30-frame glow (the telegraph), then a slow Rime bolt, aimed level from the chest. Takes the ranged token.
    id: "ac_bell_cast",
    anim: "ac_bell_cast",
    total_frames: 80,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (80, 0.0)],
    track_deg_per_tick: 4.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [],
    projectiles: [
      (frame: 30, projectile: "proj_rime_bolt", offset: (0.0, 1.3, 0.6), yaw_deg: 0.0, pitch_deg: 0.0),
    ],
    sfx: [(8, "chant")],
    vfx: [(0, "glow_rime")],
  ),
]
