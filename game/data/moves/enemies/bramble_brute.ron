    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (18, 0.0), (22, 0.24), (64, 0.24)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: "bb_slam",
    hitboxes: [
      (
        frames: (22, 26),
        shape: Capsule(a: (0.0, 1.3, 0.3), b: (0.0, 1.3, 2.0), radius: 0.45),
        motion_value: 1.2,
        phys: Slash,
        element: None,
        poise_damage: 24,
        status: [],
