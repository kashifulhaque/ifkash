// Enemy moves for WP-036 (the Drowned). Registry numbers 8310-8311. Schema:
// crates/content/src/moves.rs. Every attack telegraphs for at least 12 frames before its
// first active hitbox frame or projectile (docs/game/05-enemies-and-bosses.md, "Enemy
// roster"; checked by the validator). Damage comes from the enemy's `attack` (and
// `element_attack`) in enemies/*.ron, so `motion_value` is the only multiplier here. Numbers
// are tuning.
#![enable(implicit_some)]
[
  (
    // The grab: both arms out, a 24-frame reach. Unblockable, so only a dodge (an i-frame roll) avoids it. Tuned so a hit costs about 20% of the player's HP.
    id: "dr_grab",
    anim: "dr_grab",
    total_frames: 72,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (24, 0.0), (28, 0.6), (72, 0.6)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (24, 28),
        shape: Capsule(a: (0.0, 1.0, 0.3), b: (0.0, 1.0, 1.5), radius: 0.55),
        motion_value: 1.5,
        phys: Neutral,
        element: None,
        poise_damage: 30,
        status: [],
        knockback: 0.0,
        hitstop: 6,
        tags: [Grab, Unblockable],
      ),
    ],
    projectiles: [],
    sfx: [(14, "drowned_gurgle")],
    vfx: [(24, "water_drip")],
  ),
  (
    // A slow arm swipe.
    id: "dr_swipe",
    anim: "dr_swipe",
    total_frames: 58,
    stamina: 0,
    fp: 0,
    root_motion: [(0, 0.0), (18, 0.0), (22, 0.3), (58, 0.3)],
    track_deg_per_tick: 3.0,
    hyperarmor: None,
    iframes: None,
    cancel_attack_from: None,
    cancel_dodge_from: None,
    cancel_any_from: None,
    next_chain: None,
    hitboxes: [
      (
        frames: (20, 23),
        shape: Capsule(a: (0.0, 1.0, 0.2), b: (0.0, 1.0, 1.3), radius: 0.45),
        motion_value: 0.8,
        phys: Blunt,
        element: None,
        poise_damage: 22,
        status: [],
        knockback: 0.8,
        hitstop: 4,
        tags: [],
      ),
    ],
    projectiles: [],
    sfx: [(16, "swing_heavy")],
    vfx: [],
  ),
]
