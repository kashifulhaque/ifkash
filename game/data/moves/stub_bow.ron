// `stub: true`. Schema: crates/content/src/moves.rs.
#![enable(implicit_some)]
[
  (
    // LIGHT: an arrow from the chest, aimed along the facing. The move turns toward the
    // lock target until the arrow leaves.
    id: "stub_bow_shot",
    anim: "bow_shoot",
    total_frames: 24, // tuning
    stamina: 6, // tuning
    fp: 0,
    root_motion: [],
