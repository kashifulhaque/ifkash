    hyperarmor: None,
    iframes: None,
    cancel_attack_from: 20, // tuning
    cancel_dodge_from: 14, // tuning
    cancel_any_from: 20, // tuning
    next_chain: None,
    hitboxes: [],
    projectiles: [
      (frame: 8, projectile: "proj_arrow", offset: (0.0, 1.4, 0.5), yaw_deg: 0.0, pitch_deg: 0.0),
    ],
    sfx: [(8, "bow_release")],
    vfx: [],
    stub: true,
  ),
  (
    // HEAVY: a seeker bolt launched 70 degrees to the left, which curves toward its target.
