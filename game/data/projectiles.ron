// Projectile definitions. Schema: crates/content/src/projectiles.rs. A move launches one
// from its `projectiles` list. Sources: docs/game/01-architecture.md, "Physics"
// (projectiles are shape casts) and docs/game/03-combat.md, "Spells". The numbers are
// tuning: no spec row fixes a projectile's speed, drop, or turn rate yet.
#![enable(implicit_some)]
[
  (
    // An arrow: fast, falls under gravity, stops at the first actor or wall it hits.
    id: "proj_arrow",
    speed: 40.0, // tuning: 1.3 m a tick
    gravity: 12.0, // tuning: drops 0.4 m over 10 m
    radius: 0.05, // tuning
    lifetime_ticks: 90, // tuning: 3 seconds
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Pierce,
    element: None,
    poise_damage: 8, // tuning
    knockback: 0.2, // tuning
    hitstop: 2, // tuning
    tags: [],
  ),
  (
    // A seeker bolt (a stand-in for the Formulae spells of WP-055): flies straight and
    // turns toward the shooter's lock target, or else the nearest actor.
    id: "proj_seeker_bolt",
    speed: 12.0, // tuning: 0.4 m a tick
    gravity: 0.0,
    radius: 0.15, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: (turn_deg_per_tick: 8.0, range_m: 20.0), // tuning
    motion_value: 1.2, // tuning
    phys: Neutral,
    element: Aether,
    poise_damage: 10, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // The Acolyte's Radiance bolt (WP-036): slow, so the 30-tick glow and the flight both
    // give a player time to move. A Formula: elemental, no physical type, so a Shard Golem
    // reflects it. Damage comes from the Acolyte's `element_attack`.
    id: "proj_radiance_bolt",
    speed: 7.0, // tuning: 0.23 m a tick
    gravity: 0.0,
    radius: 0.2, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Neutral,
    element: Radiance,
    poise_damage: 12, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // The Bell Acolyte's Rime bolt (WP-036): the Radiance bolt's flight with 40 Rime
    // buildup (`status`). A Formula too, so a Shard Golem reflects it.
    id: "proj_rime_bolt",
    speed: 7.0, // tuning
    gravity: 0.0,
    radius: 0.2, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: None,
    motion_value: 0.8, // tuning
    phys: Neutral,
    element: Aether,
    poise_damage: 12, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
    status: (kind: Rime, amount: 40), // tuning
  ),
  (
    // The Lantern Thief's pitch bomb (WP-037): a slow lobbed Fire shot with a high arc.
    // A direct hit is the whole effect; there are no area hits yet.
    id: "proj_pitch_bomb",
    speed: 16.0, // tuning: about half a meter a tick
    gravity: 8.0, // tuning
    radius: 0.2, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Neutral,
    element: Fire,
    poise_damage: 14, // tuning
    knockback: 0.4, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  // WP-057: the player's throwables and the special arrows. Their damage comes from the
  // item (`effect` in consumables.ron), not from the thrower's weapon, so `motion_value`
  // is 1.0. None is a Formula: each carries a physical type, so a Shard Golem doesn't
  // reflect it and Scholar's Seal doesn't boost it.
  (
    // Pitch Bomb: a lobbed Fire burst, 2 m radius (Consumables).
    id: "proj_pitch_bomb_thrown",
    speed: 14.0, // tuning
    gravity: 9.0, // tuning
    radius: 0.2, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Blunt,
    element: Fire,
    poise_damage: 14, // tuning
    knockback: 0.4, // tuning
    hitstop: 3, // tuning
    tags: [],
    area_radius_m: 2.0, // Consumables: 2 m radius
  ),
  (
    // Frostjar: 60 Aether and 80 Rime buildup.
    id: "proj_frostjar",
    speed: 14.0, // tuning
    gravity: 9.0, // tuning
    radius: 0.2, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Blunt,
    element: Aether,
    poise_damage: 8, // tuning
    knockback: 0.2, // tuning
    hitstop: 2, // tuning
    tags: [],
    status: (kind: Rime, amount: 80), // Consumables: Rime 80
  ),
  (
    // Blight Pot: 120 Blight buildup, and the minimum of damage.
    id: "proj_blight_pot",
    speed: 14.0, // tuning
    gravity: 9.0, // tuning
    radius: 0.2, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Blunt,
    element: None,
    poise_damage: 4, // tuning
    knockback: 0.1, // tuning
    hitstop: 1, // tuning
    tags: [],
    status: (kind: Blight, amount: 120), // Consumables: Blight 120
  ),
  (
    // Poison Knife: 40 Pierce and 40 Poison buildup. Flat and fast.
    id: "proj_throwing_knife",
    speed: 24.0, // tuning
    gravity: 4.0, // tuning
    radius: 0.08, // tuning
    lifetime_ticks: 60, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Pierce,
    element: None,
    poise_damage: 6, // tuning
    knockback: 0.1, // tuning
    hitstop: 1, // tuning
    tags: [],
    status: (kind: Poison, amount: 40), // Consumables: Poison 40
  ),
  (
    // Fire Arrow: an arrow with Fire added (the item's `elem_percent` of the bow's AR).
    id: "proj_arrow_fire",
    speed: 40.0, // as proj_arrow
    gravity: 12.0,
    radius: 0.05,
    lifetime_ticks: 90,
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Pierce,
    element: Fire,
    poise_damage: 8,
    knockback: 0.2,
    hitstop: 2,
    tags: [],
  ),
  (
    // Storm Arrow: as the Fire Arrow, with Storm.
    id: "proj_arrow_storm",
    speed: 40.0, // as proj_arrow
    gravity: 12.0,
    radius: 0.05,
    lifetime_ticks: 90,
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Pierce,
    element: Storm,
    poise_damage: 8,
    knockback: 0.2,
    hitstop: 2,
    tags: [],
  ),
  (
    // The bow heavy's arrow (WP-052): a drawn shot, faster and harder than a light arrow.
    id: "proj_arrow_heavy",
    speed: 46.0, // tuning
    gravity: 10.0, // tuning
    radius: 0.06, // tuning
    lifetime_ticks: 100, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.6, // tuning
    phys: Pierce,
    element: None,
    poise_damage: 14, // tuning
    knockback: 0.4, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // The bow's fully drawn arrow (WP-052): flies nearly flat, and pierces one extra target.
    id: "proj_arrow_charged",
    speed: 52.0, // tuning
    gravity: 8.0, // tuning
    radius: 0.07, // tuning
    lifetime_ticks: 110, // tuning
    pierce: 1,
    homing: None,
    motion_value: 2.2, // tuning
    phys: Pierce,
    element: None,
    poise_damage: 22, // tuning
    knockback: 0.6, // tuning
    hitstop: 4, // tuning
    tags: [],
  ),
  (
    // WP-054: a glass shard from Glass Barrage: fast and straight, with a small hit radius
    // (tuning: no spec row fixes the shard's numbers).
    id: "proj_glass_shard",
    speed: 36.0, // tuning
    gravity: 0.0,
    radius: 0.1, // tuning
    lifetime_ticks: 60, // tuning
    pierce: 0,
    homing: None,
    motion_value: 0.8, // tuning
    phys: Pierce,
    element: Aether,
    poise_damage: 6, // tuning
    knockback: 0.1, // tuning
    hitstop: 2,
    tags: [],
  ),
  (
    // WP-074, B06: the Cantor's chorus orb (verse move). Slow and steering gently, so a roll
    // or a sidestep sheds it: 0.2 m a tick, turning 2 degrees a tick. Radiance, a Formula.
    // Damage comes from the Cantor's `attack`. (tuning: no spec row fixes the numbers)
    id: "proj_b06_chorus_orb",
    speed: 6.0, // tuning
    gravity: 0.0,
    radius: 0.3, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: (turn_deg_per_tick: 2.0, range_m: 25.0), // tuning
    motion_value: 0.9, // tuning
    phys: Neutral,
    element: Radiance,
    poise_damage: 14, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // WP-074, B06: the Lamenter's Rime knife: quick and straight, 30 Rime buildup per hit.
    // Fired three to a throw, fanned 12 degrees apart. (tuning)
    id: "proj_b06_rime_knife",
    speed: 14.0, // tuning
    gravity: 0.0,
    radius: 0.12, // tuning
    lifetime_ticks: 50, // tuning
    pierce: 0,
    homing: None,
    motion_value: 0.6, // tuning
    phys: Pierce,
    element: Aether,
    poise_damage: 8, // tuning
    knockback: 0.2, // tuning
    hitstop: 2, // tuning
    tags: [],
    status: (kind: Rime, amount: 30), // tuning
  ),
  (
    // WP-072: B04's Poison glob (docs/game/05-enemies-and-bosses.md, "B04 Mossgut Brood": she
    // spits Poison globs, arcing, with a ground marker). A slow lob that bursts where it lands:
    // everyone within 1.5 m of the end point takes the hit. Damage comes from the Brood's
    // `attack`. Speed, arc, and radius are tuning.
    id: "proj_b04_glob",
    speed: 14.0, // tuning: about 0.47 m a tick
    gravity: 9.0, // tuning
    radius: 0.3, // tuning
    lifetime_ticks: 120, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Neutral,
    element: None,
    poise_damage: 14, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
    status: (kind: Poison, amount: 70), // tuning
    area_radius_m: 1.5, // tuning
  ),
  (
    // WP-079, B11: the Exile's orb (b11_orbs): slow and gently steering, so a roll or a
    // sidestep sheds it: 0.2 m a tick, turning 2 degrees a tick. Aether. Damage comes from
    // the Exile's `attack` and `element_attack`. (tuning: no spec row fixes the numbers)
    id: "proj_b11_orb",
    speed: 6.0, // tuning
    gravity: 0.0,
    radius: 0.3, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: (turn_deg_per_tick: 2.0, range_m: 25.0), // tuning
    motion_value: 0.9, // tuning
    phys: Neutral,
    element: Aether,
    poise_damage: 14, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
]
