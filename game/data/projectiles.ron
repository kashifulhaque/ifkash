// Projectile definitions. Schema: crates/content/src/projectiles.rs. A move launches one
// from its `projectiles` list. Sources: docs/game/01-architecture.md, "Physics"
// (projectiles are shape casts) and docs/game/03-combat.md, "Spells". The numbers are
// tuning: no spec row fixes a projectile's speed, drop, or turn rate yet.
#![enable(implicit_some)]
[
  (
    // An arrow: fast, falls under gravity, stops at the first actor or wall it hits.
    id: "proj_arrow",
    speed: 40.0, // tuning: 1.3 m a tick
    gravity: 12.0, // tuning: drops 0.4 m over 10 m
    radius: 0.05, // tuning
    lifetime_ticks: 90, // tuning: 3 seconds
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Pierce,
    element: None,
    poise_damage: 8, // tuning
    knockback: 0.2, // tuning
    hitstop: 2, // tuning
    tags: [],
  ),
  (
    // A seeker bolt (a stand-in for the Formulae spells of WP-055): flies straight and
    // turns toward the shooter's lock target, or else the nearest actor.
    id: "proj_seeker_bolt",
    speed: 12.0, // tuning: 0.4 m a tick
    gravity: 0.0,
    radius: 0.15, // tuning
    lifetime_ticks: 90, // tuning
    pierce: 0,
    homing: (turn_deg_per_tick: 8.0, range_m: 20.0), // tuning
    motion_value: 1.2, // tuning
    phys: Neutral,
    element: Aether,
    poise_damage: 10, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // The Acolyte's Radiance bolt (WP-036): slow, so the 30-tick glow and the flight both
    // give a player time to move. A Formula: elemental, no physical type, so a Shard Golem
    // reflects it. Damage comes from the Acolyte's `element_attack`.
    id: "proj_radiance_bolt",
    speed: 7.0, // tuning: 0.23 m a tick
    gravity: 0.0,
    radius: 0.2, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: None,
    motion_value: 1.0,
    phys: Neutral,
    element: Radiance,
    poise_damage: 12, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
  ),
  (
    // The Bell Acolyte's Rime bolt (WP-036): the Radiance bolt's flight with 40 Rime
    // buildup (`status`). A Formula too, so a Shard Golem reflects it.
    id: "proj_rime_bolt",
    speed: 7.0, // tuning
    gravity: 0.0,
    radius: 0.2, // tuning
    lifetime_ticks: 150, // tuning
    pierce: 0,
    homing: None,
    motion_value: 0.8, // tuning
    phys: Neutral,
    element: Aether,
    poise_damage: 12, // tuning
    knockback: 0.3, // tuning
    hitstop: 3, // tuning
    tags: [],
    status: (kind: Rime, amount: 40), // tuning
  ),
]
