// The B01 boss arena (WP-034): a round chamber 18 m across with four pillars, and the
// Hollow Sentry. docs/game/05-enemies-and-bosses.md, "B01 Hollow Sentry". The level format
// (WP-040) has no round rooms yet, so the chamber is a square floor of boxes.
//   - The player spawns at (0, 0, -8) facing +Z, outside the fog gate.
//   - The fog gate is the plane z = 0, 8 m wide, opening into the chamber (+Z).
//   - The chamber is x in [-9, 9], z in [0, 18]; the Sentry waits at (0, 0, 13), facing -Z.
//   - Walls close the east, west, and far sides (the arena has no edge to fall off).
//   - Four pillars, 1 m square and 4 m tall, stand at (+-5, 5) and (+-5, 13).
(
  spawn: (0.0, 0.0, -8.0),
  spawn_yaw: 0.0,
  kill_y: -12.0,
  heightfield: None,
  boxes: [
    (name: "floor", center: (0.0, -0.5, 4.5), half_extents: (9.0, 0.5, 13.5)),
    (name: "wall_west", center: (-9.5, 3.0, 9.0), half_extents: (0.5, 3.0, 9.5)),
    (name: "wall_east", center: (9.5, 3.0, 9.0), half_extents: (0.5, 3.0, 9.5)),
    (name: "wall_back", center: (0.0, 3.0, 18.5), half_extents: (10.0, 3.0, 0.5)),
    (name: "pillar_nw", center: (-5.0, 2.0, 13.0), half_extents: (0.5, 2.0, 0.5)),
    (name: "pillar_ne", center: (5.0, 2.0, 13.0), half_extents: (0.5, 2.0, 0.5)),
    (name: "pillar_sw", center: (-5.0, 2.0, 5.0), half_extents: (0.5, 2.0, 0.5)),
    (name: "pillar_se", center: (5.0, 2.0, 5.0), half_extents: (0.5, 2.0, 0.5)),
  ],
  start_glimmer: 0,
  bosses: [
    (
      name: "b01",
      boss: "b01_hollow_sentry",
      pos: (0.0, 0.0, 13.0),
      yaw: 3.1415927,
      gate: (pos: (0.0, 0.0, 0.0), yaw: 0.0, half_width_m: 4.0, depth_m: 2.0),
    ),
  ],
)
