    (name: "ante_west", center: (-5.0, 5.0, -6.0), half_extents: (1.0, 5.0, 6.0)),
    (name: "ante_east", center: (5.0, 5.0, -6.0), half_extents: (1.0, 5.0, 6.0)),
    (name: "ante_south", center: (0.0, 5.0, -12.5), half_extents: (6.0, 5.0, 0.5)),
    (name: "pillar_w0", center: (-14.0, 5.0, 10.0), half_extents: (0.8, 5.0, 0.8)),
