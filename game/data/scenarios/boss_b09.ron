// The B09 boss arena (WP-077): Lamplight Hollow's cavern, and the Lamplight Matriarch.
// docs/game/05-enemies-and-bosses.md, "B09 The Lamplight Matriarch". The scenario keeps the
// level's x and z (the cavern is x 78..146, z 94..146, entered from the corridor x 98..110 at the
// plane z = 92; see game/data/levels/hollowdeep) on a flat floor at y = 0, so the boss's `params`
// (lamp offsets, arena half extents, in meters from her spawn) fit both.
//   - The player spawns at (104, 0, 82) facing +Z, in the corridor, outside the fog gate.
//   - The fog gate is the plane z = 92, 12 m wide, opening north into the cavern.
//   - The Matriarch waits at (112, 0, 120) facing -Z (toward the gate).
//   - Six unlit lamps stand 20 m from her spawn, 60 degrees apart (lamp_0 to the east); four
//     pillars, 2.5 m square and 12 m tall, stand at (92, 108), (132, 108), (92, 134), (132, 134).
//   - The cavern has no edge to fall off, and the pillars leave lanes 20 m wide between them.
//   - The darkness rule and the glowing zones are the level's, so phase 2's drained light has
//     something to take away (`lf_core::ai::bosses::b09`).
(
  spawn: (104.0, 0.0, 82.0),
  spawn_yaw: 0.0,
  kill_y: -12.0,
  heightfield: None,
  boxes: [
    (name: "floor", center: (112.0, -0.5, 120.0), half_extents: (34.0, 0.5, 26.0)),
    (name: "corridor_floor", center: (104.0, -0.5, 85.0), half_extents: (6.0, 0.5, 9.0)),
    (name: "wall_west", center: (77.5, 6.0, 120.0), half_extents: (0.5, 6.0, 26.5)),
    (name: "wall_east", center: (146.5, 6.0, 120.0), half_extents: (0.5, 6.0, 26.5)),
    (name: "wall_north", center: (112.0, 6.0, 146.5), half_extents: (34.5, 6.0, 0.5)),
    (name: "wall_gate_w", center: (87.5, 6.0, 93.5), half_extents: (10.5, 6.0, 0.5)),
    (name: "wall_gate_e", center: (128.5, 6.0, 93.5), half_extents: (18.5, 6.0, 0.5)),
    (name: "corridor_wall_w", center: (97.5, 6.0, 85.0), half_extents: (0.5, 6.0, 9.0)),
    (name: "corridor_wall_e", center: (110.5, 6.0, 85.0), half_extents: (0.5, 6.0, 9.0)),
    (name: "corridor_wall_s", center: (104.0, 6.0, 75.5), half_extents: (6.5, 6.0, 0.5)),
    (name: "lamp_0", center: (132.0, 1.5, 120.0), half_extents: (0.7, 1.5, 0.7)),
    (name: "lamp_1", center: (122.0, 1.5, 137.32), half_extents: (0.7, 1.5, 0.7)),
    (name: "lamp_2", center: (102.0, 1.5, 137.32), half_extents: (0.7, 1.5, 0.7)),
    (name: "lamp_3", center: (92.0, 1.5, 120.0), half_extents: (0.7, 1.5, 0.7)),
    (name: "lamp_4", center: (102.0, 1.5, 102.68), half_extents: (0.7, 1.5, 0.7)),
    (name: "lamp_5", center: (122.0, 1.5, 102.68), half_extents: (0.7, 1.5, 0.7)),
    (name: "arena_pillar0", center: (92.0, 6.0, 108.0), half_extents: (1.25, 6.0, 1.25)),
    (name: "arena_pillar1", center: (132.0, 6.0, 108.0), half_extents: (1.25, 6.0, 1.25)),
    (name: "arena_pillar2", center: (92.0, 6.0, 134.0), half_extents: (1.25, 6.0, 1.25)),
    (name: "arena_pillar3", center: (132.0, 6.0, 134.0), half_extents: (1.25, 6.0, 1.25)),
  ],
  start_glimmer: 0,
  // The Lantern Sword (found in the dark nook west of the Fungal Shore) deals Fire, which lights
  // the lamps and which she is weak to. It stands in for a mid-game kit.
  player_weapon: Some("wpn_lantern_sword"),
  darkness: Some((visibility_m: 6.0, torch_visibility_m: 14.0, lantern_light_m: 9.0, torch_flag: "codex.projects.smoltorch")),
  glows: [
    (name: "glow_corridor", center: (104.0, 85.0), half_extents: (7.0, 9.0)),
    (name: "glow_arena", center: (112.0, 120.0), half_extents: (32.0, 26.0)),
  ],
  bosses: [
    (
      name: "b09",
      boss: "b09_lamplight_matriarch",
      pos: (112.0, 0.0, 120.0),
      yaw: 3.1415927,
      gate: (pos: (104.0, 0.0, 92.0), yaw: 0.0, half_width_m: 6.0, depth_m: 3.0),
    ),
  ],
  echo_stones: [
    (id: "stone_b09", pos: (94.0, 0.0, 100.0), yaw: 0.7854),
  ],
)
