// The B11 boss arena (WP-079, `BossArena-v0`): a flat copy of the Bound Ring and the Bound Exile.
// docs/game/05-enemies-and-bosses.md, "B11 The Bound Exile". It keeps the level's x and z
// (game/data/levels/bound_ring), so the boss's `params` (the ring's center and radius, in
// meters from its spawn) fit both. The level's seal sigil and door are left out: the fight
// starts when the player walks through the gate, as it does once the sigil is touched.
//   - The player spawns at (0, 0, -30) facing +Z, on the road, outside the fog gate.
//   - The fog gate is the plane z = -14, 12 m wide, opening north into the Ring.
//   - The Ring's floor runs x -26..26, z -22..30, with twelve standing stones at a radius of 21 m
//     about (0, 4), and the prisoner's plinth at (0, 16), 0.5 m high.
//   - The Exile stands on the plinth at (0, 0.5, 16) facing -Z (south, toward the gate). Its
//     eight blink stones are at a radius of 15 m about (0, 4), inside the ring of standing stones.
(
  spawn: (0.0, 0.0, -30.0),
  spawn_yaw: 0.0,
  kill_y: -12.0,
  heightfield: None,
  boxes: [
    (name: "floor", center: (0.0, -0.5, 4.0), half_extents: (26.0, 0.5, 26.0)),
    (name: "road", center: (0.0, -0.5, -41.0), half_extents: (6.0, 0.5, 19.0)),
    (name: "wall_west", center: (-27.0, 5.0, 4.0), half_extents: (1.0, 5.0, 26.0)),
    (name: "wall_east", center: (27.0, 5.0, 4.0), half_extents: (1.0, 5.0, 26.0)),
    (name: "wall_north", center: (0.0, 5.0, 31.0), half_extents: (28.0, 5.0, 1.0)),
    (name: "wall_south_w", center: (-16.0, 5.0, -22.5), half_extents: (10.0, 5.0, 0.5)),
    (name: "wall_south_e", center: (16.0, 5.0, -22.5), half_extents: (10.0, 5.0, 0.5)),
    (name: "road_wall_w", center: (-6.5, 5.0, -41.0), half_extents: (0.5, 5.0, 19.0)),
    (name: "road_wall_e", center: (6.5, 5.0, -41.0), half_extents: (0.5, 5.0, 19.0)),
    (name: "plinth", center: (0.0, 0.25, 16.0), half_extents: (1.5, 0.25, 1.5)),
    (name: "stone_0", center: (20.2, 3.0, 9.4), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_1", center: (14.8, 3.0, 18.8), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_2", center: (5.4, 3.0, 24.2), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_3", center: (-5.4, 3.0, 24.2), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_4", center: (-14.8, 3.0, 18.8), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_5", center: (-20.2, 3.0, 9.4), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_6", center: (-20.2, 3.0, -1.4), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_7", center: (-14.8, 3.0, -10.8), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_8", center: (-5.4, 3.0, -16.2), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_9", center: (5.4, 3.0, -16.2), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_10", center: (14.8, 3.0, -10.8), half_extents: (0.8, 3.0, 0.8)),
    (name: "stone_11", center: (20.2, 3.0, -1.4), half_extents: (0.8, 3.0, 0.8)),
  ],
  start_glimmer: 0,
  player_weapon: Some("wpn_gray_greatsword"),
  bosses: [
    (
      name: "b11",
      boss: "b11_bound_exile",
      pos: (0.0, 0.5, 16.0),
      yaw: 3.1415927,
      gate: (pos: (0.0, 0.0, -14.0), yaw: 0.0, half_width_m: 6.0, depth_m: 3.0),
    ),
  ],
)
