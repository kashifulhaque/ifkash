// WP-024 parry golden: a flat floor and one dummy that swings every 90 ticks. The player
// starts at the origin facing +Z with the parrying dagger; the dummy stands 1.4 m ahead
// facing the player (yaw pi). Padded (HP 600, flat defense 500) so it survives a riposte.
(
  spawn: (0.0, 0.0, 0.0),
  spawn_yaw: 0.0,
  kill_y: -50.0,
  heightfield: None,
  boxes: [
    (name: "floor", center: (0.0, -0.5, 0.0), half_extents: (1000.0, 0.5, 1000.0)),
  ],
  player_weapon: Some("wpn_parry_dagger"),
  dummies: [
    (
      name: "duelist", pos: (0.0, 0.0, 1.4), yaw: 3.1415927, hp: 600, defense: (flat: 500),
      unaware: false, attack: Some((move_id: "dummy_slash", first_tick: 40, every_ticks: 90)),
    ),
  ],
)
