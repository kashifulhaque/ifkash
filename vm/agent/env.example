# Copied to ~/docs/infra/claude-remote/.env (mode 600) on first deploy.
# The agent rejects every request until all three Access values are set.
OWNER_EMAIL=haque.kashiful7@gmail.com
ACCESS_TEAM_DOMAIN=ifkash.cloudflareaccess.com
# AUD tag of the "ifkash vm" Access application (claude.ifkash.dev).
ACCESS_AUD=
# Origins allowed to send POSTs and open the terminal. Add
# http://localhost:5180 while testing the /vm page from a local dev server.
ALLOWED_ORIGINS=https://ifkash.dev
